/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TEMPORARY config for standalone/fasta_makedb_taxonomy_mmseqs_blast.nf
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Layered on top of the pipeline's nextflow.config (loaded because the runner is
    launched from the repository root), so the pipeline's profiles, resource labels
    and conf/modules.config all apply.
----------------------------------------------------------------------------------------
*/

params {
    fasta       = null      // protein FASTA (plain or .gz)
    tax_mapping = null      // accession<TAB>taxid, no header
    taxdump     = null      // NCBI taxdump directory or .tar.gz (mmseqs only)
    tool        = 'mmseqs'  // 'mmseqs' or 'blast'
    db_id       = 'uniprot' // database name (meta.id)
    max_cpus    = 4         // cap per task; the pipeline's labels ask for up to 12 CPUs
    max_memory  = '8.GB'    // cap per task; MMSEQS_CREATEINDEX otherwise asks for 200 GB
}

process {
    resourceLimits = [
        cpus:   params.max_cpus as int,
        memory: params.max_memory as String,
        time:   '24.h',
    ]

    // Keep intermediate steps out of --outdir; publish only the final database and the check
    withName: 'UNTAR|.*:MMSEQS_CREATEDB|.*:MMSEQS_CREATETAXDB' {
        publishDir = [ enabled: false ]
    }
    withName: '.*:MMSEQS_CREATEINDEX|.*:BLAST_MAKEBLASTDB|.*:CHECK_TAXONOMY' {
        publishDir = [
            path: { "${params.outdir}/database" },
            mode: params.publish_dir_mode,
        ]
    }
}
